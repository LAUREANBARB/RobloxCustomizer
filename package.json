{
  "name": "roblox-customizer",
  "version": "1.0.6",
  "description": "Roblox cursor & sound swapper with update-proof auto-apply",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "vite build && electron .",
    "dist": "vite build && electron-packager . RobloxCustomizer --platform=win32 --arch=x64 --out=release --overwrite --asar.unpackDir=custom-assets",
    "dist:linux": "vite build && electron-packager . RobloxCustomizer --platform=linux --arch=x64 --out=release --overwrite --asar.unpackDir=custom-assets",
    "dist:all": "vite build && electron-packager . RobloxCustomizer --platform=win32,linux --arch=x64 --out=release --overwrite --asar.unpackDir=custom-assets",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\" --ignore-path .prettierignore",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.robloxcustomizer.app",
    "productName": "RobloxCustomizer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "custom-assets/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^32.0.0",
    "electron-packager": "^17.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "prettier": "^3.9.6",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
